---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { visibleProjects } from '../data/projects';

const google = visibleProjects.filter((p) => p.group === 'google');
const earlier = visibleProjects.filter((p) => p.group === 'earlier');
---

<Base title="Projects" description="Projects by Joanna Hong at Google DeepMind, Trillion Labs, Meta Reality Labs, and KAIST.">
  <h1 class="page-title fade-in">Projects</h1>
  <p class="page-lede">Things I've built and shipped, from Gemini audio launches to multilingual LLMs and audio-visual speech models.</p>

  <section class="section">
    <div class="section-head"><span>Google DeepMind</span></div>
    <p class="intro sub">
      On the Gemini Audio team I work on speech and audio understanding for Gemini, from core model capabilities to safety
      alignment for audio-in and audio-out launches. Launches I contributed to:
    </p>
    <div class="stack">{google.map((p) => <ProjectRow project={p} />)}</div>
  </section>

  <section class="section">
    <div class="section-head"><span>Earlier</span></div>
    <div class="stack">{earlier.map((p) => <ProjectRow project={p} />)}</div>
  </section>
</Base>

<style>
  .intro {
    margin: 0 0 20px;
    max-width: 620px;
    font-size: 14.5px;
  }
  .stack {
    margin-top: -8px;
  }
</style>
