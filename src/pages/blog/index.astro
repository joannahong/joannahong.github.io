---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Blog" description="Notes by Joanna Hong on speech, audio, multimodal models, and research life.">
  <h1 class="page-title fade-in">Blog</h1>
  <p class="page-lede">Notes on speech, audio, multimodal models, and the occasional thing I learned the hard way.</p>
  <div class="meta mono">
    {tags.map((t) => <a class="tag" href={`/blog/tags/${t}/`}>{t}</a>)}
    <a class="rss" href="/rss.xml">rss ↗</a>
  </div>

  {
    posts.length === 0 ? (
      <p class="muted mono section">Nothing here yet. Soon.</p>
    ) : (
      years.map((y) => (
        <section class="section">
          <div class="section-head">
            <span>{y}</span>
          </div>
          <PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === y)} />
        </section>
      ))
    )
  }
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 18px;
  }
  .meta a {
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--accent);
  }
  .rss {
    font-size: 12px;
    color: var(--muted);
    margin-left: auto;
  }
  .section {
    margin-top: 48px;
  }
</style>
