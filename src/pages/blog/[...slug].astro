---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime } from '../../lib/posts';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const mins = readingTime(post.body);
---

<Base title={title} description={description} type="article">
  <article class="post">
    <header class="fade-in">
      <a class="back mono" href="/blog/">← blog</a>
      <h1 class="serif">{title}</h1>
      <div class="meta mono">
        <time datetime={date.toISOString()}>{fmt(date)}</time>
        <span>·</span>
        <span>{mins} min read</span>
        {updated && <span>· updated {fmt(updated)}</span>}
        {post.data.draft && <span class="badge accent">draft</span>}
      </div>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((t) => (
              <a class="tag" href={`/blog/tags/${t}/`}>
                {t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="More posts">
    {
      older ? (
        <a href={`/blog/${older.id}/`}>
          <span class="mono muted">← older</span>
          <span class="serif">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a class="right" href={`/blog/${newer.id}/`}>
          <span class="mono muted">newer →</span>
          <span class="serif">{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  .post header {
    margin: 56px 0 40px;
  }
  .back {
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
  }
  h1 {
    font-weight: 400;
    font-size: clamp(32px, 5vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: 18px 0 12px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .tags {
    display: flex;
    gap: 12px;
    margin-top: 10px;
  }
  .tags a {
    text-decoration: none;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
  }
  .pager .mono {
    font-size: 12px;
  }
  .pager .serif {
    font-size: 17px;
    line-height: 1.3;
  }
  .pager .right {
    text-align: right;
    grid-column: 2;
  }
</style>
