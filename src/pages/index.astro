---
import Base from '../layouts/Base.astro';
import Waveform from '../components/Waveform.astro';
import PubItem from '../components/PubItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { news } from '../data/news';
import { visibleProjects } from '../data/projects';
import { selectedPublications } from '../data/publications';

const featured = visibleProjects.filter((p) => p.featured).slice(0, 4);
---

<Base>
  <section class="hero fade-in">
    <div class="intro">
      <div class="eyebrow mono">
        {profile.role} · {profile.org} · {profile.location}
      </div>
      <!-- Name already sits in the header on desktop; shown here only on mobile, where the header hides it. -->
      <h1 class="serif mobile-name">{profile.name}</h1>
      <p class="headline">Speech, audio, and multimodal AI.</p>
      <div class="bio">
        <p>
          I'm a research scientist on the <strong>{profile.team}</strong> team at <strong>{profile.org}</strong>, where I work on
          speech and audio understanding for Gemini, from core model capabilities to safety alignment for audio-in and audio-out
          launches.
        </p>
        <p>
          Before that I helped build multilingual LLMs at Trillion Labs, interned at Meta Reality Labs, and received my Ph.D.
          from KAIST with{' '}
          <a href="https://www.ivllab.kaist.ac.kr/people/professor" target="_blank" rel="noopener noreferrer">Prof. Yong Man Ro</a>. My thesis on human speech understanding through multimodal representation learning received the
          Outstanding Dissertation Award.
        </p>
      </div>
      <div class="cta mono">
        <a href={profile.cv} target="_blank" rel="noopener noreferrer">CV ↗</a>
        {profile.links.slice(0, 3).map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}
        <a class="email" data-user={profile.email.user} data-domain={profile.email.domain} href="#">
          {profile.email.user} [at] {profile.email.domain.replace('.', ' [dot] ')}
        </a>
      </div>
    </div>
    <img class="photo" src={profile.photo} alt={`Portrait of ${profile.name}`} width="400" height="400" />
  </section>

  <Waveform />

  <section class="section">
    <div class="section-head"><span>News</span></div>
    <ul class="news">
      {
        news.slice(0, 6).map((n) => (
          <li>
            <span class="mono muted date">{n.date}</span>
            <span class="text">
              {n.href ? (
                <a href={n.href} target="_blank" rel="noopener noreferrer">
                  {n.text}
                </a>
              ) : (
                n.text
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><span>Projects</span><a href="/projects/">View all</a></div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><span>Selected publications</span><a href="/publications/">View all</a></div>
    <ul class="plain">
      {selectedPublications.map((p) => <PubItem pub={p} compact />)}
    </ul>
  </section>

</Base>

<script>
  // Assemble the mailto link on the client to keep scrapers away.
  document.querySelectorAll<HTMLAnchorElement>('a.email').forEach((a) => {
    const addr = `${a.dataset.user}@${a.dataset.domain}`;
    a.href = `mailto:${addr}`;
    a.textContent = addr;
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 168px;
    gap: 40px;
    align-items: start;
    margin-top: 64px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .headline {
    font-size: clamp(28px, 4.6vw, 36px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .mobile-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .bio p {
    margin: 0 0 12px;
    color: var(--sub);
    max-width: 560px;
  }
  .bio p:first-child {
    font-size: 15px;
    color: var(--fg);
  }
  .bio p + p {
    font-size: 14px;
  }
  .bio strong {
    color: var(--fg);
    font-weight: 500;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 18px;
    font-size: 13px;
  }
  .cta a {
    text-decoration: none;
    color: var(--muted);
  }
  .cta a:hover {
    color: var(--accent);
  }
  .photo {
    width: 168px;
    height: 168px;
    object-fit: cover;
    border-radius: 50%;
    /* The source JPG is a circle on a white square whose circle is ~0.5% smaller than
       the frame, which leaves a hairline white ring. Clip slightly inside it. */
    clip-path: circle(48.8% at 50% 50%);
  }

  .news {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .news li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 12px;
    padding: 7px 0;
    font-size: 14px;
    align-items: baseline;
  }
  .date {
    font-size: 12.5px;
  }
  .text a {
    text-decoration: none;
  }
  .text a:hover {
    text-decoration: underline;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  /* An odd last card spans the full row instead of leaving a hole. */
  .grid > :global(:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 600px) {
    .headline {
      font-size: 22px;
      color: var(--sub);
    }
    .mobile-name {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
      font-weight: 500;
      font-size: 32px;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin: 0 0 8px;
    }
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 40px;
    }
    .photo {
      order: -1;
      width: 96px;
      height: 96px;
      margin: 0 0 24px;
      border-radius: 50%;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .news li {
      grid-template-columns: 44px 1fr;
    }
  </style>
