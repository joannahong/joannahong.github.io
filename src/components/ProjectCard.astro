---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const primary = p.links?.[0]?.href;
---

<article class="card">
  <div class="top mono">
    <span class="org">{p.org}</span>
    <span class="muted">{p.period}</span>
  </div>
  <h3 class="serif">
    {primary ? <a href={primary} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}
  </h3>
  <p class="sub">{p.summary}</p>
  {p.bullets && <ul>{p.bullets.map((b) => <li>{b}</li>)}</ul>}
  <div class="foot">
    <div class="tags">{p.tags?.map((t) => <span class="tag">{t}</span>)}</div>
    {
      p.links && (
        <div class="links mono">
          {p.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .card {
    padding: 22px 22px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    gap: 12px;
  }
  .org {
    color: var(--accent);
  }
  h3 {
    font-weight: 450;
    font-size: 18.5px;
    line-height: 1.3;
    margin: 8px 0 6px;
  }
  h3 a {
    text-decoration: none;
  }
  p {
    margin: 0;
    font-size: 14px;
  }
  ul {
    margin: 10px 0 0;
    padding-left: 18px;
    font-size: 13.5px;
    color: var(--sub);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .links {
    display: flex;
    gap: 12px;
    font-size: 12.5px;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
