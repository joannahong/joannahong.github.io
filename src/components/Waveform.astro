---
// Decorative animated waveform, a nod to speech & audio work.
// Bar heights are deterministic so the build is stable.
const N = 64;
const bars = Array.from({ length: N }, (_, i) => {
  const x = i / (N - 1);
  const env = Math.sin(Math.PI * x) ** 0.8; // fade at the edges
  const v = 0.25 + 0.75 * Math.abs(Math.sin(i * 1.7) * 0.6 + Math.sin(i * 0.43) * 0.4);
  return Math.max(0.08, env * v);
});
// Gemini gradient stops, interpolated per bar.
const stops = [
  [0, [66, 133, 244]],
  [0.55, [155, 114, 203]],
  [1, [217, 101, 112]],
] as const;
const colorAt = (t: number) => {
  const j = t <= stops[1][0] ? 0 : 1;
  const [t0, c0] = stops[j];
  const [t1, c1] = stops[j + 1];
  const u = (t - t0) / (t1 - t0);
  return `rgb(${c0.map((v, k) => Math.round(v + (c1[k] - v) * u)).join(',')})`;
};
---

<div class="wave" aria-hidden="true">
  {bars.map((h, i) => <span style={`--h:${h.toFixed(3)};--d:${(i * 0.045).toFixed(3)}s;--c:${colorAt(i / (N - 1))}`} />)}
</div>

<style>
  .wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 36px;
    margin: 36px 0 0;
    opacity: 0.9;
  }
  span {
    flex: 1;
    max-width: 4px;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: var(--c);
    opacity: calc(0.35 + var(--h) * 0.65);
    transform-origin: center;
    animation: breathe 2.4s ease-in-out infinite;
    animation-delay: var(--d);
  }
  :global([data-theme='dark']) span {
    filter: brightness(1.3) saturate(1.1);
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scaleY(0.55);
    }
    50% {
      transform: scaleY(1);
    }
  }
</style>
