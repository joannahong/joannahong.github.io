---
import type { CollectionEntry } from 'astro:content';
interface Props {
  posts: CollectionEntry<'blog'>[];
  showYear?: boolean;
}
const { posts, showYear = false } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', ...(showYear ? { year: 'numeric' } : {}), timeZone: 'UTC' });
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <time class="mono" datetime={post.data.date.toISOString()}>
            {fmt(post.data.date)}
          </time>
          <span class="title serif">{post.data.title}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="desc">{post.data.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }
  li:first-child {
    border-top: none;
  }
  a {
    display: grid;
    grid-template-columns: 112px 1fr auto;
    align-items: baseline;
    gap: 20px;
    text-decoration: none;
  }
  time {
    font-size: 12.5px;
    color: var(--muted);
  }
  .title {
    font-size: 19px;
    line-height: 1.35;
  }
  .arrow {
    color: var(--muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s, transform 0.15s;
  }
  a:hover .arrow {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }
  .desc {
    margin: 2px 0 0 132px;
    font-size: 14.5px;
    color: var(--sub);
  }
  @media (max-width: 600px) {
    a {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .arrow {
      display: none;
    }
    .desc {
      margin-left: 0;
    }
  }
</style>
